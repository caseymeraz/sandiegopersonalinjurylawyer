---
import Layout from '../../layouts/Layout.astro';
import lawyers from '../../data/lawyers.json';

export function getStaticPaths() {
  return lawyers.map((lawyer) => ({
    params: { slug: lawyer.slug },
    props: { lawyer },
  }));
}

const { lawyer } = Astro.props;

const title = `${lawyer.name} - ${lawyer.firm} | San Diego Personal Injury Lawyer`;
const description = `${lawyer.name} of ${lawyer.firm} is ranked #${lawyer.rank} among San Diego personal injury lawyers. ${lawyer.primarySpecialty} specialist with ${lawyer.yearsExperience}+ years of experience and a ${lawyer.googleRating} Google rating.`;

const dynamicYears = lawyer.admissionYear ? new Date().getFullYear() - lawyer.admissionYear : lawyer.yearsExperience;
const telPhone = lawyer.phone?.replace(/[^\d+]/g, '');
const stateBarUrl = lawyer.barNumber ? `https://apps.calbar.ca.gov/attorney/Licensee/Detail/${lawyer.barNumber}` : null;

function parseAddress(addressStr: string) {
  const parts = addressStr.split(',').map((s: string) => s.trim());
  const streetAddress = parts[0] || '';
  const city = parts[1] || 'San Diego';
  const stateZip = (parts[2] || 'CA').split(' ').filter(Boolean);
  const state = stateZip[0] || 'CA';
  const zip = stateZip[1] || '';
  return { streetAddress, city, state, zip };
}

const addr = parseAddress(lawyer.address);

// Related attorneys: same officeArea or overlapping specialtyTags, excluding self
const related = lawyers
  .filter(l => l.slug !== lawyer.slug)
  .filter(l => l.officeArea === lawyer.officeArea || l.specialtyTags?.some((t: string) => lawyer.specialtyTags?.includes(t)))
  .slice(0, 3);

// Schema: LegalService + BreadcrumbList
const legalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": lawyer.name,
  "description": lawyer.bio,
  "url": lawyer.website,
  "telephone": lawyer.phone,
  "image": lawyer.photo || undefined,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": addr.streetAddress,
    "addressLocality": addr.city,
    "addressRegion": addr.state,
    "postalCode": addr.zip,
    "addressCountry": "US"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": lawyer.googleRating,
    "reviewCount": lawyer.googleReviews,
    "bestRating": 5,
    "worstRating": 1
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sandiegopersonalinjurylawyer.co/" },
    { "@type": "ListItem", "position": 2, "name": "Rankings", "item": "https://sandiegopersonalinjurylawyer.co/#rankings" },
    { "@type": "ListItem", "position": 3, "name": lawyer.name, "item": `https://sandiegopersonalinjurylawyer.co/lawyers/${lawyer.slug}/` }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
      <!-- Breadcrumb -->
      <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1">
          <li><a href="/" class="hover:text-blue-600">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href="/#rankings" class="hover:text-blue-600">Rankings</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-gray-900 font-medium">{lawyer.name}</li>
        </ol>
      </nav>

      <!-- Profile Card -->
      <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
        <!-- Header -->
        <div class="p-6 md:p-8 border-b border-gray-100">
          <div class="flex items-start gap-5">
            {lawyer.photo ? (
              <div class="relative flex-shrink-0">
                <img
                  src={lawyer.photo}
                  alt={`${lawyer.name} - San Diego Personal Injury Attorney`}
                  class="w-24 h-24 md:w-28 md:h-28 rounded-full object-cover border-2 border-gray-200"
                  width="112"
                  height="112"
                />
                <div class="absolute -bottom-1 -right-1 w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-lg">
                  #{lawyer.rank}
                </div>
              </div>
            ) : (
              <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg">
                #{lawyer.rank}
              </div>
            )}
            <div class="flex-1 min-w-0">
              <h1 class="text-2xl md:text-3xl font-bold text-gray-900">{lawyer.name}</h1>
              <p class="text-gray-600 text-lg">{lawyer.firm}</p>
              <div class="mt-2">
                <span class="text-3xl font-bold text-blue-600">{lawyer.score.toFixed(1)}</span>
                <span class="text-sm text-gray-500 ml-1">/ 100 Score</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="px-6 md:px-8 py-4 bg-gray-50 border-b border-gray-100">
          <div class="flex flex-wrap gap-3">
            {lawyer.licenseStatus === 'Active' && (
              <span class="inline-flex items-center text-xs font-medium text-green-700">
                <span class="w-2 h-2 bg-green-500 rounded-full mr-1.5"></span>
                State Bar: Verified Active
              </span>
            )}
            {lawyer.disciplinaryStatus && (
              <span class="inline-flex items-center text-xs font-medium text-green-700">
                <span class="w-2 h-2 bg-green-500 rounded-full mr-1.5"></span>
                Discipline: {lawyer.disciplinaryStatus}
              </span>
            )}
            {stateBarUrl && (
              <a href={stateBarUrl} target="_blank" rel="nofollow noopener noreferrer" class="inline-flex items-center text-xs font-medium text-blue-600 hover:text-blue-800">
                <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                License: #{lawyer.barNumber}
              </a>
            )}
          </div>
        </div>

        <div class="p-6 md:p-8 space-y-6">
          <!-- Editor's Note -->
          {lawyer.editorsNote && (
            <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
              <h2 class="text-sm font-semibold text-blue-800 uppercase tracking-wide mb-2">Why Choose This Attorney</h2>
              <p class="text-blue-900 text-sm leading-relaxed">{lawyer.editorsNote}</p>
            </div>
          )}

          <!-- Metrics Grid -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="p-3 bg-blue-50 rounded-lg">
              <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Experience</div>
              <div class="text-lg font-bold text-gray-900">{dynamicYears} years</div>
            </div>
            <div class="p-3 bg-blue-50 rounded-lg">
              <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Specialty</div>
              <div class="text-lg font-bold text-gray-900 truncate">{lawyer.primarySpecialty || 'Personal Injury'}</div>
            </div>
            <div class="p-3 bg-blue-50 rounded-lg">
              <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Google Rating</div>
              <div class="flex items-baseline gap-1">
                <span class="text-lg font-bold text-gray-900">{lawyer.googleRating?.toFixed(1)}</span>
                <span class="text-xs text-gray-500">({lawyer.googleReviews?.toLocaleString()})</span>
              </div>
            </div>
            {lawyer.reviewSentiment && lawyer.reviewSentiment.length > 0 && (
              <div class="p-3 bg-blue-50 rounded-lg">
                <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Sentiment</div>
                <div class="text-sm text-gray-700 mt-0.5">{lawyer.reviewSentiment.join(', ')}</div>
              </div>
            )}
          </div>

          <!-- Notable Verdict -->
          {lawyer.notableVerdict && (
            <div class="flex items-center gap-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
              <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <div>
                <span class="text-xs font-medium text-amber-600 uppercase tracking-wide">Notable Result</span>
                <p class="text-sm font-semibold text-amber-900">{lawyer.notableVerdict}</p>
              </div>
            </div>
          )}

          <!-- Badges -->
          {lawyer.badges && lawyer.badges.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {lawyer.badges.map((badge: string) => (
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-amber-100 to-yellow-100 text-amber-800 border border-amber-200">
                  <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  {badge}
                </span>
              ))}
            </div>
          )}

          <!-- Languages & Fee Structure -->
          <div class="grid md:grid-cols-2 gap-4">
            {lawyer.languages && lawyer.languages.length > 0 && (
              <div>
                <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Languages</h3>
                <div class="flex flex-wrap gap-1.5">
                  {lawyer.languages.map((lang: string) => (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">{lang}</span>
                  ))}
                </div>
              </div>
            )}
            {lawyer.feeStructure && (
              <div>
                <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Fee Structure</h3>
                <p class="text-sm text-gray-700">{lawyer.feeStructure}</p>
              </div>
            )}
          </div>

          <!-- Bio -->
          {lawyer.bio && (
            <div>
              <h2 class="text-lg font-bold text-gray-900 mb-2">About {lawyer.name}</h2>
              <p class="text-gray-600 leading-relaxed">{lawyer.bio}</p>
            </div>
          )}

          <!-- Office Location -->
          {lawyer.address && (
            <div>
              <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Office Location</h3>
              <div class="flex items-start gap-2 text-sm">
                <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div>
                  <span class="text-gray-700">{lawyer.address}</span>
                  {lawyer.officeArea && <span class="text-gray-500 ml-1">({lawyer.officeArea})</span>}
                </div>
              </div>
            </div>
          )}

          <!-- Contact Actions -->
          <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-100">
            {lawyer.phone && (
              <a href={`tel:${telPhone}`} class="inline-flex items-center px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                {lawyer.phone}
              </a>
            )}
            {lawyer.website && (
              <a href={lawyer.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                Visit Website
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Related Attorneys -->
      {related.length > 0 && (
        <div class="mt-10">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Related Attorneys</h2>
          <div class="grid md:grid-cols-3 gap-4">
            {related.map((rel) => (
              <a href={`/lawyers/${rel.slug}/`} class="block bg-white rounded-lg shadow-sm border border-gray-100 p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 font-bold text-xs">#{rel.rank}</div>
                  <div>
                    <div class="font-semibold text-gray-900 text-sm">{rel.name}</div>
                    <div class="text-xs text-gray-500">{rel.firm}</div>
                  </div>
                </div>
                <div class="flex items-center gap-2 text-xs text-gray-600">
                  <span class="font-semibold text-blue-600">{rel.score.toFixed(1)}</span>
                  <span>Score</span>
                  <span class="text-gray-300">|</span>
                  <span>{rel.googleRating} rating</span>
                  <span class="text-gray-300">|</span>
                  <span>{rel.officeArea}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back to Rankings -->
      <div class="mt-8 text-center">
        <a href="/#rankings" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to All Rankings
        </a>
      </div>
    </div>
  </main>
</Layout>
