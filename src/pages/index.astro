---
import Layout from '../layouts/Layout.astro';
import LawyerCard from '../components/LawyerCard.astro';
import lawyers from '../data/lawyers.json';

const title = "Best Personal Injury Lawyers in San Diego (2026) | Verified Rankings";
const description = "Find the top-rated personal injury lawyers in San Diego, CA. Our rankings are based on verified State Bar credentials and Google reviews. All attorneys verified through the California State Bar.";

// Dynamic updated date (auto-updates on each build)
const updatedDate = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

// Quick Match top 4
const quickMatch = [
  { bestFor: "High Stakes/Verdicts", slug: "john-h-gomez", name: "John H. Gomez", credential: "$100M+ Won", rating: 4.9, rank: 1 },
  { bestFor: "Client Satisfaction", slug: "michael-patrick-hernandez", name: "Michael Patrick Hernandez", credential: "Perfect 5.0", rating: 5.0, rank: 6 },
  { bestFor: "Complex Litigation", slug: "david-seabold-casey-jr", name: "David Seabold Casey Jr.", credential: "50+ Years Exp", rating: 4.8, rank: 11 },
  { bestFor: "Personal Attention", slug: "adrian-m-terrado", name: "Adrian M. Terrado", credential: "Boutique Firm", rating: 5.0, rank: 9 },
];

// Collect unique specialty tags and office areas for filter dropdowns
const allSpecialties = [...new Set(lawyers.flatMap(l => (l as any).specialtyTags || []))].sort();
const allAreas = [...new Set(lawyers.map(l => (l as any).officeArea).filter(Boolean))].sort();

// Helper to parse address into structured PostalAddress
function parseAddress(addressStr: string) {
  const parts = addressStr.split(',').map(s => s.trim());
  const streetAddress = parts[0] || '';
  const city = parts[1] || 'San Diego';
  const stateZip = (parts[2] || 'CA').split(' ').filter(Boolean);
  const state = stateZip[0] || 'CA';
  const zip = stateZip[1] || '';
  return { streetAddress, city, state, zip };
}

// Schema.org ItemList for rankings
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Best Personal Injury Lawyers in San Diego",
  "description": "Rankings of the top personal injury attorneys in San Diego based on verified credentials and client reviews",
  "numberOfItems": lawyers.length,
  "itemListElement": lawyers.map((lawyer, index) => {
    const addr = parseAddress(lawyer.address);
    const item: Record<string, any> = {
      "@type": "LegalService",
      "name": lawyer.name,
      "description": lawyer.bio,
      "url": lawyer.website,
      "telephone": lawyer.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": addr.streetAddress,
        "addressLocality": addr.city,
        "addressRegion": addr.state,
        "postalCode": addr.zip,
        "addressCountry": "US"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": lawyer.googleRating,
        "reviewCount": lawyer.googleReviews,
        "bestRating": 5,
        "worstRating": 1
      }
    };
    if ((lawyer as any).photo) {
      item.image = (lawyer as any).photo;
    }
    return {
      "@type": "ListItem",
      "position": index + 1,
      "item": item
    };
  })
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I choose the best personal injury lawyer in San Diego?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Look for attorneys with active State Bar of California licenses, strong client reviews, and experience handling cases similar to yours. Consider their years of experience, communication style, and whether they work on contingency (no fee unless you win)."
      }
    },
    {
      "@type": "Question",
      "name": "How are these San Diego personal injury lawyers ranked?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our rankings are based on verified State Bar of California credentials and Google review data. We verify each attorney's license status through the official State Bar database and factor in their Google rating and review count."
      }
    },
    {
      "@type": "Question",
      "name": "What does a personal injury lawyer cost in San Diego?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most San Diego personal injury lawyers work on a contingency fee basis, meaning you pay nothing upfront and they only get paid if you win your case. Typical contingency fees range from 33% to 40% of the settlement or verdict."
      }
    },
    {
      "@type": "Question",
      "name": "How long do I have to file a personal injury claim in California?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "California's statute of limitations for most personal injury claims is 2 years from the date of injury. Claims against government entities have a shorter deadline of 6 months. It's important to consult an attorney promptly to protect your rights."
      }
    },
    {
      "@type": "Question",
      "name": "Where do I file a personal injury lawsuit in San Diego?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Personal injury cases in San Diego are typically filed at the Hall of Justice (330 W Broadway, San Diego, CA 92101), which houses the San Diego Superior Court. Your attorney will handle the filing process and ensure all documents are submitted to the correct courthouse."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do about medical attention after an accident in San Diego?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Seek medical attention immediately after an accident. Major trauma cases in San Diego are often routed to Scripps Mercy Hospital or UCSD Medical Center, both Level I trauma centers. Even if injuries seem minor, getting examined creates medical documentation that strengthens your personal injury claim."
      }
    },
    {
      "@type": "Question",
      "name": "Will my case go to court, or will it settle?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Approximately 95% of personal injury cases in San Diego settle before trial. If your case does go to trial, it will be heard at the Hall of Justice (330 W Broadway). Your attorney handles all court appearances, filings, and trial preparation. Cases that go to trial often result in higher awards, but they also carry more risk and take longer to resolve."
      }
    },
    {
      "@type": "Question",
      "name": "How does California's comparative negligence law affect my case?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "California uses a pure comparative negligence system, meaning you can recover compensation even if you were partially at fault for your accident. Your total compensation is reduced by your percentage of fault. For example, if you are found 20% at fault and your damages total $100,000, you would receive $80,000. This makes California one of the more plaintiff-friendly states for personal injury claims."
      }
    }
  ]
};
---

<Layout title={title} description={description} canonicalPath="/">
  <!-- Additional Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <header class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-900 text-white">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-24">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Best Personal Injury Lawyers<br class="hidden md:block" /> in San Diego
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 mb-8 max-w-3xl mx-auto">
          Verified attorney rankings based on State Bar credentials and Google reviews
        </p>

        <!-- Trust Badges -->
        <div class="flex flex-wrap justify-center gap-4 md:gap-6 mb-8">
          <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm font-medium">State Bar Verified</span>
          </div>
          <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="text-sm font-medium">Google Reviews</span>
          </div>
          <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
            <svg class="w-5 h-5 text-blue-300" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm font-medium">Updated {updatedDate}</span>
          </div>
        </div>

        <a href="#rankings" class="inline-flex items-center px-6 py-3 bg-white text-blue-900 font-semibold rounded-lg hover:bg-blue-50 transition-colors">
          View Rankings
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Methodology Section -->
    <section class="bg-white border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">How We Rank San Diego Personal Injury Lawyers</h2>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">State Bar Verification</h3>
              <p class="text-gray-600 text-sm">Every attorney's license is verified through the official State Bar of California database. We confirm active status and admission year.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-yellow-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Google Reviews</h3>
              <p class="text-gray-600 text-sm">Client reviews from Google Business Profiles are factored in, considering both the average rating and total number of reviews.</p>
            </div>
          </div>
        </div>

        <p class="text-center text-gray-500 text-sm mt-8 max-w-2xl mx-auto">
          Our methodology prioritizes verified, public data. Rankings are based on a combination of State Bar verification (50%) and Google review metrics (50%). We do not accept payment for placement.
        </p>
      </div>
    </section>

    <!-- Quick Match Summary Table -->
    <section class="bg-white border-b border-gray-200">
      <div class="max-w-4xl mx-auto px-4 py-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Quick Match: Find Your Attorney</h2>
        <p class="text-gray-600 text-center mb-6 text-sm">Top picks based on specific strengths</p>

        <div class="responsive-table">
          <table class="quick-match-table w-full text-sm">
            <thead>
              <tr class="bg-blue-900 text-white">
                <th class="px-4 py-3 text-left font-semibold">Best For...</th>
                <th class="px-4 py-3 text-left font-semibold">Attorney</th>
                <th class="px-4 py-3 text-left font-semibold">Top Credential</th>
                <th class="px-4 py-3 text-center font-semibold">Rating</th>
              </tr>
            </thead>
            <tbody>
              {quickMatch.map((match, i) => (
                <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
                  <td class="px-4 py-3 font-medium text-gray-900">{match.bestFor}</td>
                  <td class="px-4 py-3">
                    <a href={`/lawyers/${match.slug}/`} class="text-blue-600 hover:text-blue-800 font-medium hover:underline">
                      {match.name}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-gray-700">{match.credential}</td>
                  <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center gap-1">
                      <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                      <span class="font-semibold">{match.rating.toFixed(1)}</span>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Map Embed -->
    <section class="bg-gray-50 border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">San Diego Personal Injury Attorneys Near You</h2>
        <p class="text-gray-600 text-center mb-6 text-sm">Most top-rated firms are located in the downtown San Diego courthouse district</p>
        <div class="map-container rounded-xl overflow-hidden shadow-md border border-gray-200">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13418.7!2d-117.1611!3d32.7157!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80d954a8a5fb5f4d%3A0x956d3c4b0b1e09a7!2sSan%20Diego%20Superior%20Court%20-%20Hall%20of%20Justice!5e0!3m2!1sen!2sus!4v1709856000000"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map of San Diego personal injury lawyer offices near the courthouse district"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Lawyer Rankings -->
    <section class="bg-gray-50" id="rankings">
      <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-2 text-center">Top {lawyers.length} Personal Injury Lawyers in San Diego</h2>
        <p class="text-gray-600 text-center mb-8">All attorneys verified through the State Bar of California</p>

        <!-- Filter Bar -->
        <div class="filter-bar bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-8">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label for="filter-specialty" class="block text-xs font-medium text-gray-600 mb-1">Specialty</label>
              <select id="filter-specialty" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500" aria-label="Filter by specialty">
                <option value="">All Specialties</option>
                {allSpecialties.map(tag => (
                  <option value={tag}>{tag}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="filter-location" class="block text-xs font-medium text-gray-600 mb-1">Location</label>
              <select id="filter-location" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500" aria-label="Filter by location">
                <option value="">All Locations</option>
                {allAreas.map(area => (
                  <option value={area}>{area}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="filter-sort" class="block text-xs font-medium text-gray-600 mb-1">Sort By</label>
              <select id="filter-sort" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500" aria-label="Sort results">
                <option value="score">Score (Default)</option>
                <option value="rating">Google Rating</option>
                <option value="reviews">Review Count</option>
                <option value="experience">Experience</option>
              </select>
            </div>
          </div>
          <div class="mt-3 text-sm text-gray-500" id="filter-count">{lawyers.length} attorneys found</div>
        </div>

        <div class="space-y-6">
          {lawyers.map((lawyer) => (
            <LawyerCard
              rank={lawyer.rank}
              name={lawyer.name}
              firm={lawyer.firm}
              barNumber={lawyer.barNumber}
              licenseStatus={lawyer.licenseStatus}
              admissionYear={lawyer.admissionYear}
              yearsExperience={lawyer.yearsExperience}
              googleRating={lawyer.googleRating}
              googleReviews={lawyer.googleReviews}
              phone={lawyer.phone}
              address={lawyer.address}
              website={lawyer.website}
              bio={lawyer.bio}
              score={lawyer.score}
              photo={(lawyer as any).photo}
              disciplinaryStatus={(lawyer as any).disciplinaryStatus}
              primarySpecialty={(lawyer as any).primarySpecialty}
              notableVerdict={(lawyer as any).notableVerdict}
              lawSchool={(lawyer as any).lawSchool}
              badges={(lawyer as any).badges}
              reviewSentiment={(lawyer as any).reviewSentiment}
              slug={(lawyer as any).slug}
              editorsNote={(lawyer as any).editorsNote}
              languages={(lawyer as any).languages}
              feeStructure={(lawyer as any).feeStructure}
              specialtyTags={(lawyer as any).specialtyTags}
              officeArea={(lawyer as any).officeArea}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-white">
      <div class="max-w-4xl mx-auto px-4 py-12 md:py-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-10 text-center">Frequently Asked Questions</h2>

        <div class="space-y-6">
          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">How do I choose the best personal injury lawyer in San Diego?</h3>
            <p class="text-gray-600">Look for attorneys with active State Bar of California licenses, strong client reviews, and experience handling cases similar to yours. Consider their years of experience, communication style, and whether they work on contingency (no fee unless you win). Meeting with a few attorneys for free consultations can help you find the right fit.</p>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">How are these San Diego personal injury lawyers ranked?</h3>
            <p class="text-gray-600">Our rankings are based on verified State Bar of California credentials and Google review data. We verify each attorney's license status through the official State Bar database and factor in their Google rating and review count. We do not accept payment for rankings or placement.</p>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">What does a personal injury lawyer cost in San Diego?</h3>
            <p class="text-gray-600">Most San Diego personal injury lawyers work on a contingency fee basis, meaning you pay nothing upfront and they only get paid if you win your case. Typical contingency fees range from 33% to 40% of the settlement or verdict. Some attorneys may also cover case expenses and only recover them if you win.</p>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">How long do I have to file a personal injury claim in California?</h3>
            <p class="text-gray-600">California's statute of limitations for most personal injury claims is 2 years from the date of injury. Claims against government entities have a shorter deadline of 6 months. Discovery rules may extend deadlines in some cases, but it's important to consult an attorney promptly to protect your rights.</p>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Where do I file a personal injury lawsuit in San Diego?</h3>
            <p class="text-gray-600">Personal injury cases in San Diego are typically filed at the Hall of Justice (330 W Broadway, San Diego, CA 92101), which houses the San Diego Superior Court. Your attorney will handle the filing process, but cases are generally filed in the county where the injury occurred or where the defendant resides.</p>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">What should I do about medical attention after an accident in San Diego?</h3>
            <p class="text-gray-600">Seek medical attention immediately after any accident. Major trauma cases in San Diego are often routed to Scripps Mercy Hospital or UCSD Medical Center, both Level I trauma centers. Even if your injuries seem minor, getting examined right away creates medical documentation that strengthens your personal injury claim and ensures hidden injuries are identified early.</p>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Will my case go to court, or will it settle?</h3>
            <p class="text-gray-600">Approximately 95% of personal injury cases in San Diego settle before trial. If your case does go to trial, it will be heard at the Hall of Justice (330 W Broadway). Your attorney handles all court appearances, filings, and trial preparation. Cases that go to trial often result in higher awards, but they also carry more risk and take longer to resolve.</p>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">How does California's comparative negligence law affect my case?</h3>
            <p class="text-gray-600">California uses a pure comparative negligence system, meaning you can recover compensation even if you were partially at fault for your accident. Your total compensation is reduced by your percentage of fault. For example, if you are found 20% at fault and your damages total $100,000, you would receive $80,000. This makes California one of the more plaintiff-friendly states for personal injury claims.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-blue-900 text-white">
      <div class="max-w-4xl mx-auto px-4 py-12 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Injured in an Accident?</h2>
        <p class="text-blue-100 mb-6 max-w-2xl mx-auto">Contact any of the verified attorneys above for a free consultation. Most personal injury lawyers in San Diego offer free case evaluations and work on contingency.</p>
        <a href="#rankings" class="inline-flex items-center px-6 py-3 bg-white text-blue-900 font-semibold rounded-lg hover:bg-blue-50 transition-colors">
          View Attorney Rankings
        </a>
