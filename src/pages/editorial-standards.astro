---
import Layout from '../layouts/Layout.astro';

const title = "Editorial Standards | San Diego Personal Injury Lawyer Directory";
const description = "Learn how we research, verify, and rank San Diego personal injury lawyers. Our methodology uses verified State Bar data and Google reviews - no pay-to-play.";

const verificationDate = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<Layout title={title} description={description}>
  <main class="bg-white">
    <div class="max-w-3xl mx-auto px-4 py-12 md:py-20">

      <h1 class="text-4xl font-bold text-gray-900 mb-4">How We Rate San Diego Attorneys</h1>
      <p class="text-lg text-gray-600 mb-10">
        Our editorial process is designed to help injured San Diegans find qualified legal representation through transparent, data-driven rankings.
      </p>

      <!-- No Pay-to-Play -->
      <section class="mb-10 p-6 bg-green-50 border border-green-200 rounded-xl">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 text-green-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <div>
            <h2 class="text-lg font-bold text-green-900 mb-2">No Pay-to-Play</h2>
            <p class="text-green-800 text-sm">
              No attorney can pay for placement or a higher ranking on this site. Our rankings are based entirely on publicly verifiable data. We do not accept sponsored listings, paid reviews, or advertising fees from any attorney or law firm listed in our directory.
            </p>
          </div>
        </div>
      </section>

      <!-- Data Sources -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Our Data Sources</h2>

        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">State Bar of California</h3>
              <p class="text-gray-600 text-sm">Every attorney's license status, bar number, and admission year is verified directly through the official <a href="https://www.calbar.ca.gov/attorneys/lawyer-regulation/verify-a-lawyer" target="_blank" rel="nofollow noopener noreferrer" class="text-blue-600 hover:underline">State Bar of California database</a>. We confirm active licensure and check for any public disciplinary history.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Google Business Profiles</h3>
              <p class="text-gray-600 text-sm">Client review ratings and review counts are sourced from each attorney's Google Business Profile. We factor in both the average star rating and total number of reviews to assess client satisfaction.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Disciplinary History</h3>
              <p class="text-gray-600 text-sm">We review each attorney's public disciplinary record through the State Bar. Attorneys with current disciplinary actions are not eligible for our rankings. All attorneys currently listed have clean disciplinary records.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scoring Methodology -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Scoring Methodology</h2>
        <p class="text-gray-600 mb-4">
          Each attorney's overall score (out of 100) is calculated using a weighted formula:
        </p>
        <ul class="space-y-2 text-gray-600 text-sm">
          <li class="flex items-start gap-2">
            <span class="font-semibold text-gray-900 min-w-[40px]">50%</span>
            <span><strong>State Bar Credentials</strong> - Active license status, years since admission, and clean disciplinary record</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-semibold text-gray-900 min-w-[40px]">50%</span>
            <span><strong>Google Review Metrics</strong> - Average star rating weighted by total number of reviews</span>
          </li>
        </ul>
      </section>

      <!-- The Team -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">The Team</h2>
        <p class="text-gray-600">
          This directory is curated by the <a href="https://jurisdigital.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">Juris Digital</a> Research Team. Juris Digital is a legal marketing agency that specializes in helping consumers find qualified legal representation. Our research team independently verifies attorney credentials and maintains these rankings on a regular basis.
        </p>
      </section>

      <!-- Verification Date -->
      <section class="p-6 bg-gray-50 rounded-xl border border-gray-200">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-sm text-gray-600">
            <strong>Last Verified:</strong> {verificationDate}. All attorney credentials and review data are re-verified on a regular basis. Data is refreshed with each site update.
          </p>
        </div>
      </section>

      <!-- Back link -->
      <div class="mt-10 text-center">
        <a href="/" class="text-blue-600 hover:text-blue-800 font-medium hover:underline">
          &larr; Back to Attorney Rankings
        </a>
      </div>
    </div>
  </main>
</Layout>
