---
interface Props {
  rank: number;
  name: string;
  firm: string;
  barNumber?: string;
  licenseStatus?: string;
  admissionYear?: number;
  yearsExperience?: number;
  googleRating?: number;
  googleReviews?: number;
  phone?: string;
  address?: string;
  website?: string;
  email?: string;
  bio?: string;
  score: number;
  photo?: string;
}

const {
  rank,
  name,
  firm,
  barNumber,
  licenseStatus,
  admissionYear,
  yearsExperience,
  googleRating,
  googleReviews,
  phone,
  address,
  website,
  email,
  bio,
  score,
  photo
} = Astro.props;

// Generate stars display
const fullStars = googleRating ? Math.floor(googleRating) : 0;
const hasHalfStar = googleRating ? googleRating % 1 >= 0.5 : false;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

// Format phone for tel: link
const telPhone = phone?.replace(/[^\d+]/g, '');

// Generate State Bar lookup URL
const stateBarUrl = barNumber ? `https://apps.calbar.ca.gov/attorney/Licensee/Detail/${barNumber}` : null;
---

<article class="lawyer-card bg-white rounded-xl shadow-md overflow-hidden border border-gray-100" id={`lawyer-${rank}`}>
  <div class="p-6">
    <!-- Rank Badge and Header -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-4">
        {photo ? (
          <div class="relative flex-shrink-0">
            <img
              src={photo}
              alt={`${name} - San Diego Personal Injury Attorney`}
              class="w-20 h-20 rounded-full object-cover border-2 border-gray-200"
              loading="lazy"
            />
            <div class="absolute -bottom-1 -right-1 w-8 h-8 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-xs shadow-lg">
              #{rank}
            </div>
          </div>
        ) : (
          <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-lg">
            #{rank}
          </div>
        )}
        <div>
          <h2 class="text-xl font-bold text-gray-900">{name}</h2>
          <p class="text-gray-600">{firm}</p>
        </div>
      </div>
      <div class="text-right">
        <div class="text-2xl font-bold text-blue-600">{score.toFixed(1)}</div>
        <div class="text-xs text-gray-500 uppercase tracking-wide">Score</div>
      </div>
    </div>

    <!-- Verification Badges -->
    <div class="flex flex-wrap gap-2 mb-4">
      {licenseStatus === 'Active' && (
        <span class="badge-verified inline-flex items-center px-3 py-1 rounded-full text-xs font-medium text-white">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          State Bar Verified
        </span>
      )}
      {yearsExperience && yearsExperience >= 20 && (
        <span class="badge-gold inline-flex items-center px-3 py-1 rounded-full text-xs font-medium text-white">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          20+ Years Experience
        </span>
      )}
      {googleRating && googleRating >= 4.8 && googleReviews && googleReviews >= 50 && (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
          <svg class="w-3.5 h-3.5 mr-1.5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Highly Rated
        </span>
      )}
    </div>

    <!-- Google Reviews -->
    {googleRating && (
      <div class="flex items-center gap-2 mb-4">
        <div class="flex">
          {Array(fullStars).fill(0).map(() => (
            <svg class="w-5 h-5 star-filled" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
          {hasHalfStar && (
            <svg class="w-5 h-5 star-filled" fill="currentColor" viewBox="0 0 20 20">
              <defs>
                <linearGradient id={`half-${rank}`}>
                  <stop offset="50%" stop-color="currentColor"/>
                  <stop offset="50%" stop-color="#d1d5db"/>
                </linearGradient>
              </defs>
              <path fill={`url(#half-${rank})`} d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          )}
          {Array(emptyStars).fill(0).map(() => (
            <svg class="w-5 h-5 star-empty" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <span class="font-semibold text-gray-900">{googleRating.toFixed(1)}</span>
        <span class="text-gray-500">({googleReviews?.toLocaleString()} reviews)</span>
      </div>
    )}

    <!-- Bio -->
    {bio && (
      <p class="text-gray-600 text-sm mb-4 leading-relaxed">{bio}</p>
    )}

    <!-- Details Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
      {barNumber && (
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <div>
            <span class="text-gray-500">CA Bar #</span>
            {stateBarUrl ? (
              <a href={stateBarUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline ml-1">
                {barNumber}
              </a>
            ) : (
              <span class="text-gray-900 ml-1">{barNumber}</span>
            )}
          </div>
        </div>
      )}
      {yearsExperience && (
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span><span class="text-gray-500">Experience:</span> <span class="text-gray-900">{yearsExperience} years</span> (since {admissionYear})</span>
        </div>
      )}
      {address && (
        <div class="flex items-start gap-2 sm:col-span-2">
          <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="text-gray-700">{address}</span>
        </div>
      )}
    </div>

    <!-- Contact Actions -->
    <div class="flex flex-wrap gap-3 mt-5 pt-5 border-t border-gray-100">
      {phone && (
        <a href={`tel:${telPhone}`} class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {phone}
        </a>
      )}
      {website && (
        <a href={website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
          Website
        </a>
      )}
      {email && (
        <a href={`mailto:${email}`} class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Email
        </a>
      )}
    </div>
  </div>
</article>
