---
interface Props {
  rank: number;
  name: string;
  firm: string;
  barNumber?: string;
  licenseStatus?: string;
  admissionYear?: number;
  yearsExperience?: number;
  googleRating?: number;
  googleReviews?: number;
  phone?: string;
  address?: string;
  website?: string;
  email?: string;
  bio?: string;
  score: number;
  photo?: string;
  disciplinaryStatus?: string;
  primarySpecialty?: string;
  notableVerdict?: string | null;
  lawSchool?: string | null;
  badges?: string[];
  reviewSentiment?: string[];
  slug?: string;
  editorsNote?: string;
  languages?: string[];
  feeStructure?: string;
  specialtyTags?: string[];
  officeArea?: string;
}

const {
  rank,
  name,
  firm,
  barNumber,
  licenseStatus,
  admissionYear,
  googleRating,
  googleReviews,
  phone,
  address,
  website,
  email,
  bio,
  score,
  photo,
  disciplinaryStatus,
  primarySpecialty,
  notableVerdict,
  lawSchool,
  badges,
  reviewSentiment,
  slug,
  editorsNote,
  languages,
  feeStructure,
  specialtyTags,
  officeArea
} = Astro.props;

// Dynamic experience calculation
const dynamicYears = admissionYear ? new Date().getFullYear() - admissionYear : null;

// Format phone for tel: link
const telPhone = phone?.replace(/[^\d+]/g, '');

// Generate State Bar lookup URL
const stateBarUrl = barNumber ? `https://apps.calbar.ca.gov/attorney/Licensee/Detail/${barNumber}` : null;

// Profile URL
const profileUrl = slug ? `/lawyers/${slug}/` : null;
---

<article
  class="lawyer-card bg-white rounded-xl shadow-md overflow-hidden border border-gray-100"
  id={`lawyer-${rank}`}
  data-specialty-tags={specialtyTags?.join(',') || ''}
  data-area={officeArea || ''}
  data-rating={String(googleRating || 0)}
  data-reviews={String(googleReviews || 0)}
  data-experience={String(dynamicYears || 0)}
  data-score={String(score)}
>
  <div class="p-6">
    <!-- A. Header: Name + Firm + Rank Badge -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-4">
        {photo ? (
          <div class="relative flex-shrink-0">
            <img
              src={photo}
              alt={`${name} - San Diego Personal Injury Attorney`}
              class="w-20 h-20 rounded-full object-cover border-2 border-gray-200"
              loading="lazy"
              width="80"
              height="80"
            />
            <div class="absolute -bottom-1 -right-1 w-8 h-8 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-xs shadow-lg">
              #{rank}
            </div>
          </div>
        ) : (
          <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-lg">
            #{rank}
          </div>
        )}
        <div>
          {profileUrl ? (
            <h2 class="text-xl font-bold text-gray-900">
              <a href={profileUrl} class="hover:text-blue-600 transition-colors">{name}</a>
            </h2>
          ) : (
            <h2 class="text-xl font-bold text-gray-900">{name}</h2>
          )}
          <p class="text-gray-600">{firm}</p>
        </div>
      </div>
      <div class="text-right">
        <div class="text-2xl font-bold text-blue-600">{score.toFixed(1)}</div>
        <div class="text-xs text-gray-500 uppercase tracking-wide">Score</div>
      </div>
    </div>

    <!-- B. Trust Badge Row -->
    <div class="trust-badge-row flex flex-wrap gap-3 mb-4 p-3 bg-gray-50 rounded-lg border border-gray-100">
      {licenseStatus === 'Active' && (
        <span class="inline-flex items-center text-xs font-medium text-green-700">
          <span class="w-2 h-2 bg-green-500 rounded-full mr-1.5 flex-shrink-0"></span>
          State Bar: Verified Active
        </span>
      )}
      {disciplinaryStatus && (
        <span class="inline-flex items-center text-xs font-medium text-green-700">
          <span class="w-2 h-2 bg-green-500 rounded-full mr-1.5 flex-shrink-0"></span>
          Discipline: {disciplinaryStatus}
        </span>
      )}
      {barNumber && stateBarUrl && (
        <a href={stateBarUrl} target="_blank" rel="nofollow noopener noreferrer" class="inline-flex items-center text-xs font-medium text-blue-600 hover:text-blue-800">
          <svg class="w-3.5 h-3.5 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          License: #{barNumber}
        </a>
      )}
    </div>

    <!-- Editor's Note -->
    {editorsNote && (
      <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
        <div class="text-xs font-semibold text-blue-800 uppercase tracking-wide mb-1">Why Choose Them</div>
        <p class="text-sm text-blue-900 leading-relaxed">{editorsNote}</p>
      </div>
    )}

    <!-- C. Metrics Grid (2x2) -->
    <div class="metrics-grid grid grid-cols-2 gap-3 mb-4">
      <div class="p-3 bg-blue-50 rounded-lg">
        <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Experience</div>
        <div class="text-lg font-bold text-gray-900">{dynamicYears} years</div>
      </div>
      <div class="p-3 bg-blue-50 rounded-lg">
        <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Focus</div>
        <div class="text-lg font-bold text-gray-900 truncate">{primarySpecialty || 'Personal Injury'}</div>
      </div>
      <div class="p-3 bg-blue-50 rounded-lg">
        <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Google Rating</div>
        <div class="flex items-baseline gap-1">
          <span class="text-lg font-bold text-gray-900">{googleRating?.toFixed(1)}</span>
          <span class="text-xs text-gray-500">({googleReviews?.toLocaleString()} reviews)</span>
        </div>
      </div>
      {reviewSentiment && reviewSentiment.length > 0 && (
        <div class="p-3 bg-blue-50 rounded-lg">
          <div class="text-xs text-blue-600 font-medium uppercase tracking-wide">Review Sentiment</div>
          <div class="text-sm text-gray-700 mt-0.5">Clients mention: <em>'{reviewSentiment[0]}'</em>, <em>'{reviewSentiment[1]}'</em>, <em>'{reviewSentiment[2]}'</em></div>
        </div>
      )}
    </div>

    <!-- D. Notable Verdict Callout -->
    {notableVerdict && (
      <div class="notable-verdict flex items-center gap-3 mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
        <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <div>
          <span class="text-xs font-medium text-amber-600 uppercase tracking-wide">Notable Result</span>
          <p class="text-sm font-semibold text-amber-900">{notableVerdict}</p>
        </div>
      </div>
    )}

    <!-- E. Badges Row -->
    {badges && badges.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {badges.map((badge) => (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-amber-100 to-yellow-100 text-amber-800 border border-amber-200">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            {badge}
          </span>
        ))}
      </div>
    )}

    <!-- F. Bio -->
    {bio && (
      <p class="text-gray-600 text-sm mb-4 leading-relaxed">{bio}</p>
    )}

    <!-- Languages -->
    {languages && languages.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5 mb-3">
        <span class="text-xs text-gray-500 font-medium">Languages:</span>
        {languages.map((lang) => (
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">{lang}</span>
        ))}
      </div>
    )}

    <!-- Fee Structure -->
    {feeStructure && (
      <p class="text-xs text-gray-500 mb-4">
        <span class="font-medium">Fees:</span> {feeStructure}
      </p>
    )}

    <!-- Address -->
    {address && (
      <div class="flex items-start gap-2 text-sm mb-4">
        <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="text-gray-700">{address}{officeArea && ` (${officeArea})`}</span>
      </div>
    )}

    <!-- G. Contact Actions -->
    <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-100">
      {phone && (
        <a href={`tel:${telPhone}`} class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {phone}
        </a>
      )}
      {website && (
        <a href={website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
          Website
        </a>
      )}
      {profileUrl && (
        <a href={profileUrl} class="inline-flex items-center px-4 py-2 bg-blue-50 text-blue-700 text-sm font-medium rounded-lg hover:bg-blue-100 transition-colors">
          View Full Profile
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
