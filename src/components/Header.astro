---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/what-to-do-after-car-accident-san-diego/", label: "After an Accident" },
  { href: "/san-diego-dangerous-intersections/", label: "Dangerous Roads" },
  { href: "/first-consultation-checklist/", label: "Consultation Prep" },
  { href: "/editorial-standards/", label: "Editorial Standards" },
];
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between" aria-label="Main navigation">
    <a href="/" class="text-lg font-bold text-gray-900 hover:text-blue-600 transition-colors leading-tight">
      SD Injury<br class="sm:hidden" /> <span class="text-blue-600">Lawyer</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors ${currentPath === link.href ? 'text-blue-600' : 'text-gray-700 hover:text-blue-600'}`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-gray-700 hover:text-blue-600"
      aria-label="Open navigation menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
    <ul class="px-4 py-3 space-y-2">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`block py-2 text-sm font-medium ${currentPath === link.href ? 'text-blue-600' : 'text-gray-700'}`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }
</script>
